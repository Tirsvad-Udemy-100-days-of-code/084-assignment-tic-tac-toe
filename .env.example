# Copy to .env at the project root and fill in real values. .env is gitignored
# - never commit it (the project's .gitignore ignores .env and .env.*, and keeps
# .env.example). The program never reads this file: the tokens are for the
# maintainer's own work with the git host.

# Gitea personal access token, scoped to issues and milestones only
# (framework/scripts/sync-project.sh --apply). NOT a deploy key.
TOKEN_FOR_GITEA_ISSUES=

# Gitea personal access token with write access to the repository: push, pull
# requests, description and topics.
TOKEN_FOR_GITEA_REPO=

# Gitea personal access token for the wiki.
TOKEN_FOR_GITEA_WIKI=

# Gitea personal access token for releases.
TOKEN_FOR_GITEA_RELEASE=
